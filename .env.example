# Copy this file to ".env" and fill in your values.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6L7fsGpxvRxLG0flI0_vOq3wTl24EbzQ2DWwscLMAu6Rg
# Primary model + comma-separated fallbacks (tried in order).
# "Gemini 1.5 Flash Pro" from the project doc has been retired by Google,
# so use a current Flash model. Check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Change this to any long random string
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_PATH=data/pocketsmart.db
